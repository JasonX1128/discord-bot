DISCORD_BOT_TOKEN=your_discord_bot_token_here
TARGET_USER_ID=123456789012345678
ENABLE_NICKNAME_SYNC=true
TARGET_NICKNAME=NewNicknameHere
TARGET_REPLY_CHANCE=0.01
TARGET_REACTION_EMOJI=🍆
LOG_ALL_MESSAGES=true
LOG_MESSAGE_CONTENT=false
DISCORD_USER_WHITELIST_IDS=
USE_GEMMA=false
GEMMA_API_KEY=your_gemma_api_key_here
GEMMA_MODEL=gemma-4-26b-a4b-it
GEMMA_API_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GEMMA_TEMPERATURE=1.1
GEMMA_MAX_OUTPUT_TOKENS=80
GEMMA_SYSTEM_PROMPT=You are a Discord banter writer. Write punchy, playful one-liners that feel human and varied. Keep it cheeky, not hateful. The core inside joke is that the target user is a smut reader, so every reply should imply that in a playful way. Return plain text only.
GEMMA_STYLE_EXAMPLE_COUNT=8
ENABLE_TEST_COMMAND=true
TEST_COMMAND=!testreply
TEST_COMMAND_REQUIRES_ADMIN=true
ENABLE_GIF_COMMAND=false
GIF_COMMAND=!gif
GIF_COMMAND_REQUIRES_ADMIN=false
GIPHY_API_KEY=your_giphy_api_key_here
GIPHY_API_BASE_URL=https://api.giphy.com/v1
GIPHY_RATING=pg-13
GIPHY_LANG=en
GIPHY_DEFAULT_QUERY=reaction
GIPHY_SEARCH_LIMIT=20
GIF_MAX_ATTEMPTS=3
GIF_USE_GEMMA_CONTEXT=true
GIF_CONTEXT_MESSAGE_LIMIT=10
GIF_CONTEXT_MAX_MESSAGE_CHARS=240
GIF_RECENT_FOCUS_MESSAGE_COUNT=3
GIF_ENABLE_CANDIDATE_RERANK=true
GIF_RERANK_CANDIDATE_COUNT=8
GIF_ENABLE_VISION_RERANK=true
GIF_VISION_CANDIDATE_COUNT=5
GIF_LLM_PROVIDER=groq
GROQ_API_KEY=your_groq_key_here
GROQ_API_BASE_URL=https://api.groq.com/openai/v1
GROQ_TEXT_FALLBACK_MODELS=openai/gpt-oss-120b,llama-3.3-70b-versatile,qwen/qwen3-32b,meta-llama/llama-4-scout-17b-16e-instruct,openai/gpt-oss-20b,llama-3.1-8b-instant,allam-2-7b
ENABLE_GEMMA_LLM_FALLBACK=true
GIF_GROQ_MODEL=openai/gpt-oss-120b
GIF_VISION_MODEL=meta-llama/llama-4-scout-17b-16e-instruct
ENABLE_ARGUE_COMMAND=false
ARGUE_COMMAND=!argue
ARGUE_COMMAND_REQUIRES_ADMIN=false
ARGUE_CONTEXT_MESSAGE_LIMIT=40
ARGUE_CONTEXT_MAX_MESSAGE_CHARS=500
ARGUE_INACTIVE_TIMEOUT_MS=180000
ARGUE_REPLY_COOLDOWN_MS=12000
ARGUE_MAX_BOT_REPLIES=8
ARGUE_MAX_SESSION_MS=600000
ARGUE_RESPONSE_MAX_CHARS=700
ARGUE_MODEL=openai/gpt-oss-120b
ENABLE_MIMIC_COMMAND=false
MIMIC_COMMAND=!mimic
UNMIMIC_COMMAND=!unmimic
MIMIC_RATE_LIMIT_COMMAND=!mimicrate
MIMIC_COMMAND_REQUIRES_ADMIN=false
MIMIC_DATA_DIR=mimic_data
MIMIC_MODEL=openai/gpt-oss-120b
MIMIC_MULTILINGUAL_MODEL=qwen/qwen3-32b
MIMIC_HISTORY_FETCH_LIMIT=100
MIMIC_CONTEXT_MESSAGE_LIMIT=14
MIMIC_RECENT_EXCHANGE_LIMIT=8
MIMIC_FOLLOWUP_WINDOW_MS=180000
MIMIC_IMPLICIT_FOLLOWUP_WINDOW_MS=45000
MIMIC_THREAD_LOCK_MS=30000
MIMIC_REPLY_COOLDOWN_MS=5000
MIMIC_REPLY_MAX_CHARS=500
MIMIC_TEMPERATURE=0.75
MIMIC_STYLE_MATCH_MIN=0.65
MIMIC_ORIGINALITY_MIN=0.45
MIMIC_AUTO_REPLY_CONFIDENCE_MIN=0.72
MIMIC_FOLLOWUP_REPLY_CONFIDENCE_MIN=0.65
MIMIC_MAX_EXAMPLES=250
MIMIC_PROFILE_UPDATE_EXAMPLE_COUNT=12
MIMIC_EARLY_PROFILE_EXAMPLE_COUNT=50
MIMIC_EARLY_PROFILE_UPDATE_EXAMPLE_COUNT=3
MIMIC_UNSTABLE_PROFILE_EXAMPLE_COUNT=8
MIMIC_DISCLOSURE_PREFIX=[mimic: {name}] 
MIMIC_AUTO_REPLY_ENABLED=true
